# A4 AI Quality & Model-Risk Platform : example environment.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored). Optional values
# stay COMMENTED while absent: ``NAME=`` is an explicit empty runtime configuration and refuses.
# Every var below is consumed by config/settings.yaml via ${VAR:-default} interpolation.
# The local/test profile needs NONE of the GCP-specific values : only AI_QUALITY_PROFILE.

# ---------------------------------------------------------------------------
# Profile & project
# ---------------------------------------------------------------------------
# gcp | local | platform | onprem.  Use local for a WORKING offline run (SQLite FTS5 +
# deterministic scorer / judge, SDK-free, runs the gate end to end). onprem is the
# fail-fast migration target (the CLI exits 2 under it).
AI_QUALITY_PROFILE=local

# GCP project id (gcp/platform profiles only).
GOOGLE_CLOUD_PROJECT=your-gcp-project

# ---------------------------------------------------------------------------
# Optional: higher-fidelity local runs with Google's official emulators (opt-in).
# When set AND the matching client lib (from the [gcp] extra) imports, the in-process
# registry routes to the Firestore emulator; otherwise the default SDK-free path is used.
# ---------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---------------------------------------------------------------------------
# Optional: override the SDK-free local store paths (default: ~/.model_quality_gate/*.db;
# tests use :memory:). Leave unset for the per-package defaults.
# ---------------------------------------------------------------------------
# AI_QUALITY_LOCAL_DB=
# AI_QUALITY_LOCAL_AUDIT=
# AI_QUALITY_LOCAL_REGISTRY=   # prompt registry store; the agent registry is in-memory only
# AI_QUALITY_LOCAL_MODEL_CARDS=
# AI_QUALITY_LOCAL_METRICS=

# ---------------------------------------------------------------------------
# One region selector for runtime and Terraform. Defaults to asia-southeast1 when unset.
# GCP_REGION must be on AI_QUALITY_ALLOWED_REGIONS or the service refuses to start:
# residency is a reviewed allowlist, not a free-text field (P-03). Keep the same list in
# infra/terraform var.allowed_regions, which also drives the gcp.resourceLocations Org
# Policy. Comma-separated.
# ---------------------------------------------------------------------------
GCP_REGION=asia-southeast1
AI_QUALITY_ALLOWED_REGIONS=asia-southeast1

# ---------------------------------------------------------------------------
# Security / residency (gcp profile)
# ---------------------------------------------------------------------------
# Regional Cloud KMS key for CMEK (projects/.../locations/<GCP_REGION>/.../cryptoKeys/...)
# AI_QUALITY_KMS_KEY=projects/.../cryptoKeys/REPLACE_ME

# ---------------------------------------------------------------------------
# Agent Runtime (set AFTER you deploy the reasoningEngine)
# ---------------------------------------------------------------------------
# AI_QUALITY_AGENT_ENGINE=projects/.../reasoningEngines/REPLACE_ME

# ---------------------------------------------------------------------------
# Sibling platform services consumed by A4 (platform profile / grounded eval)
# ---------------------------------------------------------------------------
# A2 Enterprise Knowledge Base (grounded eval reference context).
KNOWLEDGE_BASE_URL=http://localhost:8082
# A3 Registry (agent registration, R4).
AGENT_REGISTRY_URL=http://localhost:8083
# A5 Observability / Audit (WORM audit, R2).
OBSERVABILITY_URL=http://localhost:8085

# Independent deployment-evidence references. Production readiness remains false unless
# every managed control has its own reviewed attestation; one flag cannot attest all controls.
# AI_QUALITY_EVALUATION_ATTESTATION_REF=evidence://REPLACE_ME
# AI_QUALITY_EVIDENCE_ATTESTATION_REF=evidence://REPLACE_ME
# AI_QUALITY_AUDIT_ATTESTATION_REF=evidence://REPLACE_ME
# AI_QUALITY_TRACE_ATTESTATION_REF=evidence://REPLACE_ME
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.test

# ---------------------------------------------------------------------------
# Identity & embedding (read directly by the app, not via settings.yaml).
# See docs/embedding-and-identity.md.
# ---------------------------------------------------------------------------
# Secure mode: the expected Cloud IAP audience the backend verifies the assertion against.
# Required when AI_QUALITY_PROFILE=gcp (or platform). Example (HTTPS LB + IAP):
#   /projects/<PROJECT_NUMBER>/global/backendServices/<BACKEND_SERVICE_ID>
# AI_QUALITY_IAP_AUDIENCE=
# Per-tenant CORS allowlist (comma-separated). Never "*". Unset => local dev origins.
# AI_QUALITY_CORS_ORIGINS=https://portal.client.com
# CSP frame-ancestors: parent origins allowed to iframe the UI (space-separated).
# Three states: unset => 'self'; set but naming no origin => the service REFUSES to start
# (an empty CSP directive is a parse error browsers discard, which would silently remove the
# clickjacking control); set => exactly those origins. To forbid all framing say 'none'.
# Keep this line COMMENTED OUT unless you are setting a value: a bare NAME= is a
# configuration, not an omission.
# Also sets X-Frame-Options: SAMEORIGIN only when 'self'.
# AI_QUALITY_FRAME_ANCESTORS='self'

# ---------------------------------------------------------------------------
# Optional: point at a non-default settings file.
# ---------------------------------------------------------------------------
# AI_QUALITY_SETTINGS=config/settings.yaml
